# OS
.DS_Store


# Python
__pycache__/
*.py[cod]
.venv/
uv.lock

# Local calibration output (regenerated on every run) — keep the folders, ignore their contents
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# Sync bookkeeping in each backend's QUAM state folder (user_scripts/sync_state_and_wiring.py)
config/quam-state/*/.sync_base/
config/quam-state/*/.sync_backup/
