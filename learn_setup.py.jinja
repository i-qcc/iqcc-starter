"""
learn_setup.py

Configures this checkout inside the IQCC Learn JupyterLab environment, where
the QM/QUAM/qualibrate stack is preinstalled and cannot be modified. Unlike
'install.py' (workstation only), it does no 'uv sync', no env-var bootstrap
and no IQCC token setup (Learn is assumed to have IQCC credentials already).
It creates the working folders, drops a
one-line 'iqcc_workspace.pth' into site-packages so 'calibration_utils' (and
'config') are importable from any working directory, and runs
'qualibrate config', then downloads the latest QUAM state and wiring for this
backend into config/quam-state/{{ backend }}/ (a re-run overwrites local state
with the cloud's latest). The IQCC credentials are checked against the cloud
first; if it rejects them the script fails and says that nodes cannot run.
'--no-iqcc-setup' skips that whole check/download (used by
'iqcc_learn_setup.py --update', so an update never overwrites local state).
To undo the import hook, delete that .pth file.

Invoke from anywhere, with the kernel's own Python:

    python learn_setup.py

Idempotent; safe to re-run.
"""

import json
import site
import subprocess
import sys
import sysconfig
from pathlib import Path

PROJECT_NAME = "{{ backend }}"


def log(msg: str) -> None:
    print(f"[iqcc-learn] {msg}")


def install_path_hook(repo_root: Path) -> None:
    # The package can't be pip-installed here (its env-var bootstrap would
    # override the image's settings), so make the checkout root importable
    # with a plain .pth file instead. User site survives image restarts.
    if site.ENABLE_USER_SITE:
        target_dir = Path(site.getusersitepackages())
    else:
        target_dir = Path(sysconfig.get_path("purelib"))
    target_dir.mkdir(parents=True, exist_ok=True)
    pth_file = target_dir / "iqcc_workspace.pth"
    pth_file.write_text(f"{repo_root}\n")
    log(f"Wrote {pth_file} -> {repo_root}")

    check = subprocess.run(
        [sys.executable, "-c", "import calibration_utils, config"],
        cwd="/", capture_output=True, text=True,
    )
    if check.returncode != 0:
        sys.exit(
            "[iqcc-learn][ERROR] 'calibration_utils' is still not importable after "
            f"writing {pth_file}. Run this script with the same Python your "
            f"kernel/terminal uses ({sys.executable} was used).\n{check.stderr}"
        )
    log("Verified 'calibration_utils' and 'config' import from any directory.")


def fail_no_state(reason: str) -> None:
    sys.exit(
        f"[iqcc-learn][ERROR] IQCC cloud check FAILED: {reason}.\n"
        "The QUAM state and wiring were NOT downloaded, so you CANNOT run "
        "calibration nodes in this checkout until this is fixed.\n"
        f"Fix: check that your IQCC credentials grant access to backend "
        f"'{PROJECT_NAME}', then re-run this script."
    )


def download_state_and_wiring(quam_state_path: Path) -> None:
    log("Verifying IQCC credentials and downloading latest QUAM state and wiring...")
    try:
        from iqcc_cloud_client import IQCC_Cloud

        qc = IQCC_Cloud(PROJECT_NAME)
        # The client prints an error but does not raise on a rejected token;
        # list() then returns None.
        listed = qc.state.list("state", limit=1)
        if listed is None:
            fail_no_state("the cloud rejected the credentials (invalid, expired, or no access to this backend)")
        if not listed:
            fail_no_state("the cloud accepted the credentials but has no QUAM state for this backend")
        latest_wiring = qc.state.get_latest("wiring")
        latest_state = qc.state.get_latest("state")
    except Exception as exc:
        fail_no_state(
            f"could not be reached or the check crashed ({exc!r}); check that "
            "iqcc_cloud_client is installed and IQCC credentials are configured"
        )
    if latest_wiring is None or latest_state is None:
        fail_no_state("the cloud returned no wiring and/or state for this backend")
    with open(quam_state_path / "wiring.json", "w") as f:
        json.dump(latest_wiring.data, f, indent=4)
    with open(quam_state_path / "state.json", "w") as f:
        json.dump(latest_state.data, f, indent=4)
    log(f"Wrote wiring.json and state.json to {quam_state_path}")


def main() -> None:
    repo_root = Path(__file__).resolve().parent
    quam_state_path = repo_root / "config" / "quam-state" / PROJECT_NAME

    install_path_hook(repo_root)

    quam_state_path.mkdir(parents=True, exist_ok=True)
    (repo_root / "config" / "qualibrate").mkdir(parents=True, exist_ok=True)
    (repo_root / "data").mkdir(exist_ok=True)
    (repo_root / "logs").mkdir(exist_ok=True)

    log(f"Configuring qualibrate (project={PROJECT_NAME})...")
    qualibrate_cmd = [
        "qualibrate", "config",
        "--project", PROJECT_NAME,
        "--storage-location", str(repo_root / "data" / PROJECT_NAME),
        "--quam-state-path", str(quam_state_path),
        "--log-folder", str(repo_root / "logs"),
        "--calibration-library-folder", str(repo_root / "calibrations"),
        "--auto-accept",
    ]
    try:
        subprocess.run(qualibrate_cmd, check=True)
    except FileNotFoundError:
        sys.exit("[iqcc-learn][ERROR] 'qualibrate' was not found on PATH.")
    except subprocess.CalledProcessError as exc:
        sys.exit(f"[iqcc-learn][ERROR] 'qualibrate config' failed with exit code {exc.returncode}.")

    if "--no-iqcc-setup" in sys.argv[1:]:
        log("--no-iqcc-setup given -- skipping the IQCC cloud check and state/wiring download.")
    else:
        download_state_and_wiring(quam_state_path)

    log(f"Done. Checkout ready at {repo_root}")


if __name__ == "__main__":
    main()
