"""
learn_setup.py

Configures this checkout inside the IQCC Learn JupyterLab environment, where
the QM/QUAM/qualibrate stack is preinstalled and cannot be modified. Unlike
'install.py' (workstation only), it does no 'uv sync', no env-var bootstrap
and no IQCC token / state download. It creates the working folders, drops a
one-line 'iqcc_workspace.pth' into site-packages so 'calibration_utils' (and
'config') are importable from any working directory, and runs
'qualibrate config'. To undo the import hook, delete that .pth file.

Invoke from anywhere, with the kernel's own Python:

    python learn_setup.py

Idempotent; safe to re-run.
"""

import site
import subprocess
import sys
import sysconfig
from pathlib import Path

PROJECT_NAME = "{{ backend }}"


def log(msg: str) -> None:
    print(f"[iqcc-learn] {msg}")


def install_path_hook(repo_root: Path) -> None:
    # The package can't be pip-installed here (its env-var bootstrap would
    # override the image's settings), so make the checkout root importable
    # with a plain .pth file instead. User site survives image restarts.
    if site.ENABLE_USER_SITE:
        target_dir = Path(site.getusersitepackages())
    else:
        target_dir = Path(sysconfig.get_path("purelib"))
    target_dir.mkdir(parents=True, exist_ok=True)
    pth_file = target_dir / "iqcc_workspace.pth"
    pth_file.write_text(f"{repo_root}\n")
    log(f"Wrote {pth_file} -> {repo_root}")

    check = subprocess.run(
        [sys.executable, "-c", "import calibration_utils, config"],
        cwd="/", capture_output=True, text=True,
    )
    if check.returncode != 0:
        sys.exit(
            "[iqcc-learn][ERROR] 'calibration_utils' is still not importable after "
            f"writing {pth_file}. Run this script with the same Python your "
            f"kernel/terminal uses ({sys.executable} was used).\n{check.stderr}"
        )
    log("Verified 'calibration_utils' and 'config' import from any directory.")


def main() -> None:
    repo_root = Path(__file__).resolve().parent
    quam_state_path = repo_root / "config" / "quam-state" / PROJECT_NAME

    install_path_hook(repo_root)

    quam_state_path.mkdir(parents=True, exist_ok=True)
    (repo_root / "config" / "qualibrate").mkdir(parents=True, exist_ok=True)
    (repo_root / "data").mkdir(exist_ok=True)
    (repo_root / "logs").mkdir(exist_ok=True)

    log(f"Configuring qualibrate (project={PROJECT_NAME})...")
    qualibrate_cmd = [
        "qualibrate", "config",
        "--project", PROJECT_NAME,
        "--storage-location", str(repo_root / "data" / PROJECT_NAME),
        "--quam-state-path", str(quam_state_path),
        "--log-folder", str(repo_root / "logs"),
        "--calibration-library-folder", str(repo_root / "calibrations"),
        "--auto-accept",
    ]
    try:
        subprocess.run(qualibrate_cmd, check=True)
    except FileNotFoundError:
        sys.exit("[iqcc-learn][ERROR] 'qualibrate' was not found on PATH.")
    except subprocess.CalledProcessError as exc:
        sys.exit(f"[iqcc-learn][ERROR] 'qualibrate config' failed with exit code {exc.returncode}.")

    log(f"Done. Put state.json / wiring.json in {quam_state_path}")


if __name__ == "__main__":
    main()
